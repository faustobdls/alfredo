{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alfredo.faustobdls.dev/schemas/memory-config.schema.json",
  "title": "Alfredo memory configuration",
  "description": "Durable settings for one Alfredo memory scope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "embeddings", "capture", "defaultScope"],
  "properties": {
    "version": { "const": 1 },
    "embeddings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "enum": ["ollama"] },
        "baseUrl": { "type": "string", "pattern": "^https?://", "maxLength": 256 },
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "dimensions": { "type": "integer", "minimum": 1, "maximum": 8192 }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionEndHook"],
      "properties": {
        "sessionEndHook": { "type": "boolean" },
        "gitDiffStat": { "type": "boolean" },
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["codex", "claude-code", "cursor", "antigravity", "generic"] }
        }
      }
    },
    "defaultScope": { "enum": ["user", "project"] }
  }
}
